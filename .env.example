# Server Environment Variables (Keep Confidential - Do Not Expose to Client)

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Token Encryption Key (32-character string for AES-256-GCM encryption of access/refresh tokens)
TOKEN_ENCRYPTION_KEY=repurposeone_secret_encryption_key_32chars_len!

# Instagram / Meta Graph API
# Register at: https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback

# LinkedIn OAuth 2.0
# Register at: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/integrations/linkedin/callback

# YouTube / Google Cloud OAuth 2.0
# Register at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/youtube/callback

# X (Twitter) API v2 with OAuth 2.0 PKCE
# Register at: https://developer.x.com/
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/integrations/x/callback
